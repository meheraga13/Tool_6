    {'full_text': 'CREATEORREPLACEFUNCTIONmain2(batch_idINTEGER,result_msgTEXT)RETURNSVOIDAS$$\n'
                  'DECLARE\n'
                  '    job_id INTEGER;\n'
                  '    status_flag TEXT;\n'
                  '    dynamic_sql TEXT;\n'
                  '    temp_value TEXT;\n'
                  'BEGIN\n'
                  '    CREATE TEMP TABLE my_temp_table (\n'
                  '        job_id INTEGER,\n'
                  '        status TEXT\n'
                  '    );\n'
                  '\n'
                  '    DECLARE job_cursor CURSOR FOR\n'
                  '        SELECT id FROM jobs WHERE batch_id = batch_id;\n'
                  '\n'
                  '    FETCH job_cursor INTO job_id;\n'
                  '\n'
                  '    WHILE FOUND LOOP\n'
                  '        BEGIN\n'
                  '            IF job_id = 1 THEN\n'
                  "                status_flag := 'First Job';\n"
                  '            ELSE\n'
                  '                IF job_id > 10 THEN\n'
                  "                    status_flag := 'Big Job';\n"
                  '                ELSE\n'
                  "                    temp_value := 'Regular Job';\n"
                  '                END IF;\n'
                  '            END IF;\n'
                  '\n'
                  "            IF status_flag = 'Big Job' THEN\n"
                  '                INSERT INTO big_jobs (job_id) VALUES '
                  '(job_id);\n'
                  '            ELSE\n'
                  '                INSERT INTO regular_jobs (job_id) '
                  'VALUES (job_id);\n'
                  '            END IF;\n'
                  '\n'
                  "            dynamic_sql := 'UPDATE jobs SET processed = "
                  "TRUE WHERE id = ' || CAST(job_id AS TEXT);\n"
                  '            EXECUTE IMMEDIATE dynamic_sql;\n'
                  '        EXCEPTION\n'
                  '            WHEN OTHERS THEN\n'
                  "                RAISE NOTICE 'Default exception handler "
                  "executed.';\n"
                  '        END;\n'
                  '\n'
                  '        FETCH job_cursor INTO job_id;\n'
                  '    END LOOP;\n'
                  '\n'
                  "    result_msg := 'Batch Processing Complete';\n"
                  '\n'
                  '    COMMIT;\n'
                  '\n'
                  '    RETURN 0;\n'
                  'END;\n'
                  '$$LANGUAGEplpgsql',
     'params': [],
     'proc_name': 'main2',
     'return_type': 'void',
     'statements': [],
     'type': 'CREATE_FUNCTION',
     'variables': []}
